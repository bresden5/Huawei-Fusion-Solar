{
  "elements": [
    {
      "type": "ValidationTextBox",
      "name": "BaseUrl",
      "caption": "FusionSolar API-Domain"
    },
    {
      "type": "ValidationTextBox",
      "name": "Username",
      "caption": "API-Kontoname"
    },
    {
      "type": "PasswordTextBox",
      "name": "Password",
      "caption": "API-SystemCode"
    },
    {
      "type": "ValidationTextBox",
      "name": "StationCode",
      "caption": "Plant-Code (optional)"
    },
    {
      "type": "NumberSpinner",
      "name": "UpdateInterval",
      "caption": "Update-Intervall (Sekunden)",
      "minimum": 60,
      "maximum": 900
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Jetzt aktualisieren",
      "onClick": "IPS_RequestAction($id, 'Update', 0);"
    }
  ]
}
